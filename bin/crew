#!/usr/bin/env bash
# crew — multi-crew-system ランチャー(配置先: ~/projects/multi-crew-system)
set -u

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

HOST="$(hostname)"
ENV_FILE="machines/${HOST}.env"
SESSION="crew"
DASH_PORT="${CREW_DASH_PORT:-7777}"

log()  { printf '\033[36m[crew]\033[0m %s\n' "$*"; }
warn() { printf '\033[33m[crew]\033[0m %s\n' "$*"; }

identity_get() {  # identity_get <dotted.key> <default>
  python3 - "$1" "${2:-}" <<'PY' 2>/dev/null
import sys
try:
    import yaml
    d = yaml.safe_load(open("identity.yaml"))
    for k in sys.argv[1].split("."):
        d = d[k]
    print(d)
except Exception:
    print(sys.argv[2])
PY
}

# 起動時にクルーシステム自体の更新を確認する。
#   origin が先行 → ローカルがクリーンなら ff-only で取り込み、取り込んだコミットを表示
#   ローカルが先行 → push(CREW_AUTO_PUSH=0 で抑止。force は使わない)
#   分岐・ローカル変更あり・到達不能 → 理由を出して見送る(起動は止めない)
cmd_sync() {
  git rev-parse --git-dir >/dev/null 2>&1 || return 0
  local branch upstream behind ahead
  branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null)" || return 0
  upstream="$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null)" \
    || { warn "同期スキップ(上流ブランチ未設定: git branch -u origin/${branch})"; return 0; }
  log "クルーシステムの更新確認 (git fetch ${upstream%%/*})"
  if ! timeout 20 git fetch --quiet "${upstream%%/*}" 2>/dev/null; then
    warn "同期スキップ(リモートに到達できない。オフライン?)"; return 0
  fi
  behind="$(git rev-list --count "HEAD..${upstream}" 2>/dev/null || echo 0)"
  ahead="$(git rev-list --count "${upstream}..HEAD" 2>/dev/null || echo 0)"
  if [ "$behind" -gt 0 ]; then
    if [ -n "$(git status --porcelain --untracked-files=no)" ]; then
      warn "更新 ${behind} 件あり。ローカルに未コミット変更があるため取り込み保留(git stash → crew up)"
    elif [ "$ahead" -gt 0 ]; then
      warn "リモートと分岐(ローカル先行 ${ahead} / 遅れ ${behind})。手動で rebase/merge してから起動を"
    elif git pull --ff-only --quiet 2>/dev/null; then
      log "更新 ${behind} 件を取り込んだ:"
      git log --oneline "HEAD@{1}..HEAD" 2>/dev/null | sed 's/^/  /'
    else
      warn "取り込み失敗(git pull --ff-only)。手動で確認を"
    fi
  elif [ "$ahead" -eq 0 ]; then
    log "クルーシステムは最新"
  fi
  if [ "$ahead" -gt 0 ] && [ "$behind" -eq 0 ]; then
    if [ "${CREW_AUTO_PUSH:-1}" = "1" ]; then
      git push --quiet "${upstream%%/*}" "$branch" 2>/dev/null \
        && log "未 push のコミット ${ahead} 件を ${upstream} へ push した" \
        || warn "push 失敗(未 push ${ahead} 件)。ネットワークか認証を確認"
    else
      log "未 push のコミット ${ahead} 件(CREW_AUTO_PUSH=0 のため送らない)"
    fi
  fi
}

start_dashboard() {
  mkdir -p state
  if [ -f state/dashboard.pid ] && kill -0 "$(cat state/dashboard.pid)" 2>/dev/null; then
    return 0
  fi
  nohup python3 dashboard/server.py >state/dashboard.log 2>&1 &
  echo $! > state/dashboard.pid
  log "ダッシュボード起動: http://localhost:${DASH_PORT}"
}

start_voicevox() {
  if [ "$(identity_get video.voicevox false)" = "True" ] || [ "$(identity_get video.voicevox false)" = "true" ]; then
    if command -v docker >/dev/null 2>&1; then
      log "VOICEVOX エンジンを起動"
      docker compose --profile video up -d voicevox 2>/dev/null || warn "VOICEVOX 起動失敗(docker を確認)"
    else
      warn "video.voicevox: true だが docker が見つからない"
    fi
  fi
}

# GM セッションの権限モード(殿指示 2026-09-03: 権限 Accept 地獄をなくす)。
#   bypass(既定) = 承認プロンプトなし。settings の deny ルールと secret guard hook はこのモードでも効く
#                  (公式: Deny rules block in every mode, including bypassPermissions)。
#   default      = 通常起動(Shift+Tab の循環に bypass を出すだけ)。
#   auto / acceptEdits / plan = そのモードで起動(循環に bypass も出す)。
# 上書きは環境変数 CREW_PERMISSION_MODE(.env に書いてもよい)。
claude_perm_args() {
  case "${CREW_PERMISSION_MODE:-bypass}" in
    bypass) echo "--dangerously-skip-permissions" ;;
    default) echo "--allow-dangerously-skip-permissions" ;;
    *) echo "--permission-mode ${CREW_PERMISSION_MODE} --allow-dangerously-skip-permissions" ;;
  esac
}

cmd_up() {
  cmd_sync
  if [ ! -f identity.yaml ]; then
    log "identity.yaml が見つかりません。初期設定を始めます。"
    bash scripts/init_wizard.sh || exit 1
  fi
  # shellcheck disable=SC1090
  [ -f "$ENV_FILE" ] && set -a && . "$ENV_FILE" && set +a
  python3 scripts/gen_settings.py || { warn "設定生成に失敗"; exit 1; }
  mkdir -p logs
  start_dashboard
  start_voicevox
  if command -v tmux >/dev/null 2>&1; then
    log "GMクルー起動 (デタッチ: Ctrl+b → d / 再接続: crew gm)"
    # shellcheck disable=SC2046
    exec tmux new-session -A -s "$SESSION" -c "$ROOT" claude $(claude_perm_args)
  else
    warn "tmux なし: 直接 claude を起動します(デタッチ不可)"
    # shellcheck disable=SC2046
    exec claude $(claude_perm_args)
  fi
}

cmd_gm()   { exec tmux attach-session -t "$SESSION"; }

open_browser() {
  URL="$1"
  if command -v wslview >/dev/null 2>&1; then wslview "$URL" >/dev/null 2>&1
  elif [ -x /mnt/c/Windows/explorer.exe ]; then /mnt/c/Windows/explorer.exe "$URL" >/dev/null 2>&1 || true   # WSL2: 既定ブラウザで開く
  elif command -v xdg-open >/dev/null 2>&1; then xdg-open "$URL" >/dev/null 2>&1
  else warn "ブラウザを自動で開けません。手動で開いてください: $URL"
  fi
}

stop_dashboard() {
  if [ -f state/dashboard.pid ]; then
    kill "$(cat state/dashboard.pid)" 2>/dev/null && log "ダッシュボード停止"
    rm -f state/dashboard.pid
  fi
}

cmd_dash() {
  # crew dash            … 起動(必要なら)+ブラウザを開く。サーバーが古い(API 不足)場合は再起動を案内
  # crew dash restart    … サーバーを再起動してからブラウザを開く(dashboard/ を更新したとき)
  if [ "${1:-}" = "restart" ]; then stop_dashboard; sleep 1; fi
  start_dashboard
  URL="http://localhost:${DASH_PORT}"
  sleep 1
  if command -v curl >/dev/null 2>&1; then
    CODE="$(curl -s -o /dev/null -w '%{http_code}' "$URL/api/closing" 2>/dev/null || echo 000)"
    if [ "$CODE" = "404" ]; then warn "ダッシュボードのサーバーが古い版で動いています。'crew dash restart' で更新してください"; fi
  fi
  log "ダッシュボード: $URL"
  open_browser "$URL"
}

cmd_down() {
  tmux kill-session -t "$SESSION" 2>/dev/null && log "GMセッション終了"
  stop_dashboard
  command -v docker >/dev/null 2>&1 && docker compose --profile video stop voicevox 2>/dev/null
  log "完全終了"
}

cmd_help() {
  cat <<'EOF'
crew — multi-crew-system(真マルチクルー環境)

  crew up       出陣(同期 → 初回はウィザード → サービス起動 → GMクルー起動)
  crew gm       GMセッションに再接続 (tmux attach)
  crew dash     ダッシュボードを開く(ブラウザ起動)。dash restart でサーバー再起動
  crew down     完全終了
  crew init     初期設定ウィザードを(再)実行
  crew doctor   環境診断(CLI・依存の検出とインストール)
  crew keys     APIキー・通知先の追加/差し替え
  crew sync     スキル・規約の同期 (git pull)
  crew test     自己診断(設定生成・secret guard・git管理外チェックを1コマンドで)
  crew decide   判断待ち台帳 (tools/decision.sh list|add|done)

  デタッチ(抜ける・生存): Ctrl+b → d
EOF
}

case "${1:-help}" in
  up)     cmd_up ;;
  gm)     cmd_gm ;;
  dash)   cmd_dash "${2:-}" ;;
  down)   cmd_down ;;
  init)   bash scripts/init_wizard.sh ;;
  doctor) bash scripts/doctor.sh ;;
  keys)   bash scripts/init_wizard.sh --keys-only ;;
  sync)   cmd_sync ;;
  test)   bash scripts/selftest.sh ;;
  decide) shift; bash tools/decision.sh "$@" ;;
  *)      cmd_help ;;
esac
